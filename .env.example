DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Default is manual. Set to playwright only after configuring a browser user data dir.
TRPG_CHATGPT_AUTOMATION=manual
TRPG_BROWSER_USER_DATA_DIR=
# Optional, for example chrome or msedge if Playwright supports the installed channel.
TRPG_BROWSER_CHANNEL=

